# ── ClipForge configuration (all optional) ─────────────────────────────
# Where clips, downloads and recordings are stored.
# CLIPFORGE_DATA=.data

# Override binaries if you have your own builds.
# FFMPEG_BIN=/usr/local/bin/ffmpeg
# FFPROBE_BIN=/usr/local/bin/ffprobe
# YTDLP_BIN=/usr/local/bin/yt-dlp
# FFMPEG_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf

# Live recording: hard cap per recording, in seconds (default 2 hours).
# CLIPFORGE_LIVE_MAX_SEC=7200

# MCP server: where the engine runs, and whether it may auto-start it.
# CLIPFORGE_ENGINE_URL=http://127.0.0.1:3000
# CLIPFORGE_AUTOSTART=1

# ── YouTube ───────────────────────────────────────────────────────────
# If YouTube says "Sign in to confirm you're not a bot", reuse your browser
# session (use a throwaway Google account, not your main one):
# YTDLP_COOKIES_FROM_BROWSER=chrome        # chrome | firefox | edge | safari
# …or point at an exported Netscape cookie jar:
# YTDLP_COOKIES_FILE=.data/cookies.txt

# Debug: dump the last ffmpeg filter graph to .data/work/last-filter.txt
# CLIPFORGE_DEBUG_FILTER=1
